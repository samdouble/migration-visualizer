{
  "name": "migration-visualizer",
  "version": "1.0.0",
  "description": "A migration visualizer for Knex.js",
  "main": "index.js",
  "author": "samdouble",
  "scripts": {
    "migrate": "knex migrate:latest",
    "migrate:list": "knex migrate:list",
    "migrate:make": "knex migrate:make -x ts",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:up": "knex migrate:up",
    "migrate:down": "knex migrate:down"
  },
  "keywords": ["knex", "migrations", "sqlite"],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
