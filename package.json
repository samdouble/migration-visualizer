{
  "name": "migration-visualizer",
  "version": "0.2.0",
  "description": "A migration visualizer for Knex.js",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "migration-visualizer": "dist/cli.js"
  },
  "author": "samdouble",
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "migrate": "knex migrate:latest",
    "migrate:list": "knex migrate:list",
    "migrate:make": "knex migrate:make -x ts",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:up": "knex migrate:up",
    "migrate:down": "knex migrate:down",
    "test": "jest --runInBand --testTimeout=20000"
  },
  "keywords": [
    "database",
    "knex",
    "mermaid",
    "migrations",
    "mysql",
    "sqlite",
    "visualizer"
  ],
  "dependencies": {
    "commander": "^14.0.2",
    "dedent": "^1.7.1",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^30.0.0",
    "better-sqlite3": "^12.5.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "mysql-memory-server": "^1.13.0",
    "mysql2": "^3.16.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.50.1"
  }
}
